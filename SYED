
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Age Checker - Shah G</title>
<style>
body {
  background: #080d18;
  color: white;
  font-family: Arial, sans-serif;
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100vh;
  margin: 0;
}
.container {
  background: #142033;
  padding: 35px;
  border-radius: 20px;
  text-align: center;
  width: 85%;
  max-width: 350px;
  box-shadow: 0 0 25px #00ff8860;
}
input, button {
  box-sizing: border-box;
  width: 100%;
  padding: 14px;
  margin-top: 15px;
  border-radius: 10px;
  border: none;
  font-size: 17px;
}
button {
  background: #00e676;
  color: #07130d;
  font-weight: bold;
  cursor: pointer;
}
button:hover {
  background: #00ff99;
  transform: scale(1.03);
}
#result {
  margin-top: 25px;
  font-size: 25px;
  font-weight: bold;
  animation: appear .4s ease;
}
@keyframes appear {
  from { opacity: 0; transform: scale(.7); }
  to { opacity: 1; transform: scale(1); }
}
</style>
</head>
<body>
<div class="container">
  <h1>AGE CHECKER 😎</h1>
  <p>Enter your age, Shah G!</p>
  <input type="number" id="age" placeholder="Enter your age" min="0" max="150">
  <button onclick="checkAge()">CHECK AGE ⚡</button>
  <div id="result"></div>
</div>

<script>
function checkAge() {
  const input = document.getElementById("age");
  const result = document.getElementById("result");
  const age = input.value.trim();

  if (age === "" || !Number.isInteger(Number(age)) ||
      Number(age) < 0 || Number(age) > 150) {
    result.style.color = "#ff5555";
    result.textContent = "Enter a valid age!";
    return;
  }

  const n = Number(age);

  if (n > 18) {
    result.style.color = "#35f58a";
    result.textContent = "GOODS SHAH G 😎🔥";
  } else if (n < 18) {
    result.style.color = "#ff5555";
    result.textContent = "NOT GOODS SHAH 😂";
  } else {
    result.style.color = "#ffd166";
    result.textContent = "EXACTLY 18 SHAH G!";
  }

  result.style.animation = "none";
  void result.offsetWidth;
  result.style.animation = "appear .4s ease";
}
</script>
</body>
</html>
